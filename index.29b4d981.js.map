"use strict";
var thumbs = document.querySelector("#thumbs");
var largeImg = document.querySelector("#largeImg");
thumbs.addEventListener("click", function(e) {
    var a = e.target.closest("a");
    if (a) e.preventDefault();
    else return;
    largeImg.src = a.href;
    largeImg.alt = a.title;
});

